{
  "name": "brittle-jobs",
  "version": "0.2.0",
  "description": "Run brittle test files concurrently, one isolated process per file, with hang detection and tmp cleanup.",
  "type": "module",
  "bin": {
    "brittle-jobs": "bin.js"
  },
  "files": [
    "bin.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/run.test.js",
    "lint": "prettier . --check",
    "format": "prettier . --write"
  },
  "prettier": "prettier-config-holepunch",
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheus1lva/brittle-jobs.git"
  },
  "license": "MIT"
}
